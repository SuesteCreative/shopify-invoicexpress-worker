{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopify-invoicexpress-worker",
  "compatibility_date": "2026-03-02",
  "main": "src/index.ts",
  "account_id": "1cec694895b74f4a87ffab3cde29bf28",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": "public"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Cloudflare's own answer to "which version is serving traffic", populated by
  // the platform on every deploy — including the ones we did not make. The
  // GIT_SHA stamp below only exists when the deploy went through
  // `npm run deploy`; Workers Builds promotes merges with a bare
  // `wrangler deploy` and leaves it empty, which used to make /admin/version
  // say "unknown" and nothing else. This binding always yields something true.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  "vars": {
    "SHOPIFY_SHOP_DOMAIN": "quickstart-66f9e5ef.myshopify.com",
    "SHOPIFY_API_VERSION": "2026-01",
    "INVOICEXPRESS_ACCOUNT_NAME": "ultramegasonico",
    "INVOICEXPRESS_TAX_INCLUDED": "true",
    "INVOICEXPRESS_AUTO_FINALIZE": "false",
    "NORMALIZE_SHOPIFY_ORDER_API_KEY": "2b752911-eb5a-4659-b353-f07a53a3680d",
    "BACKOFFICE_URL": "https://rioko.online",
    "DESTINATION_VIA_ADAPTER": "0",
    "STRIPE_SOURCE_ENABLED": "1",
    // Stripe Connect → Moloni. Ships DARK: the route 404s and the wizard is
    // hidden until the platform is enabled on Rioko's Stripe account and one
    // merchant has been onboarded end to end in a sandbox. Turning it on cannot
    // affect the restricted-key connections — different route, different secret.
    "STRIPE_CONNECT_ENABLED": "1",
    // Nightly renewal of Moloni OAuth refresh tokens (they expire after 14 idle
    // days). Pointless until the first OAuth connection exists.
    "MOLONI_TOKEN_REFRESH_ENABLED": "1",
    "RESEND_FROM_EMAIL": "noreply@rioko.online",
    "KAPTA_DEV_EMAILS": "pedrotovarporto@gmail.com",
    "INCIDENT_DIGEST_ENABLED": "0",
    "WEEKLY_MERCHANT_DIGEST_ENABLED": "1",
    "AI_PATTERN_REPORT_ENABLED": "1",
    // Recibos issued by the poll with no operator step. Turned on 04/09/2026
    // after the pre-flight dry run on both connections that run the mode came
    // back clean — Origos 10 documents all `nothing_due`, Overbuilding with
    // nothing to settle yet — and after that same dry run caught a guard that
    // would have parked eight correct documents on the first pass.
    "LODGIFY_SETTLE_AUTO": "1",
    "RECON_SWEEP_ENABLED": "1",
    "RECON_SWEEP_DAYS": "7",
    "RECON_SWEEP_DRAIN_DAYS": "90",
    "RECON_SWEEP_SHOPS": "",
    "NORMALIZE_IN_WORKER": "1",
    // Lodgify egress. CUT OVER 2026-09-03: every Lodgify call now leaves through
    // the fixed-IP relay. The gate was POST /admin/lodgify/diag on a live
    // connection, which answered direct 429 ("This IP address has been blocked…
    // flagged as an unregistered API user") and relay 200 on the same two paths,
    // same key, same instant.
    //
    // Rollback is this value: "direct" returns to the previous behaviour, which
    // is blocked but introduces no new failure mode. A MISSING value means
    // "gateway", i.e. fail closed — see src/services/lodgify-api.ts.
    // LODGIFY_GATEWAY_KEY is a `wrangler secret` and must NEVER appear here.
    "LODGIFY_EGRESS_MODE": "gateway",
    // The relay: Fly app `rioko-lodgify-relay`, org bruno-22, region cdg, egress
    // IPv4 209.71.70.77 (the address Lodgify allowlists). A hostname, not a
    // secret, and it belongs in git so a bare `wrangler deploy` cannot lose it.
    // Set while MODE is still "direct": only /admin/lodgify/diag reads it until
    // the flip, which is exactly how the cutover gets tested.
    "LODGIFY_GATEWAY_URL": "https://rioko-lodgify-relay.fly.dev",
    // One subscription per connection, enforced (migration 0044). Off, any live
    // subscription on the account let every integration through — which is how a
    // Shopify shop came to invoice for free on a subscription bought for a
    // Stripe account (Wim Hof Method, 08/09/2026). On, a connection pays for
    // itself: no row of its own, no invoices.
    //
    // Turned on 08/09/2026 after a coverage sweep of the whole fleet: exactly
    // one live connection lost cover, WHM's Shopify half, granted an early bird
    // to 15/09 in the same breath. The five shops reading "trial expirado" and
    // Casa de Celebrar a Vida are blocked at the account level already, so this
    // changes nothing for them.
    //
    // A var and not a secret on purpose: it is a policy switch, it belongs in
    // git next to the reason, and a bare `wrangler deploy` cannot lose it.
    "SUBSCRIPTION_PER_CONNECTION": "1",
    // Which InvoiceXpress proxy every document goes through. `ix-proxy.kapta.app`
    // is the one that has been serving; its source is not in any repository,
    // Cloudflare account or backup we hold, and it validates request bodies
    // against a closed schema that silently drops what it does not name — which
    // is where multi-currency was lost. `ix.rioko.online` is ours (`ix-proxy/`).
    //
    // Before flipping this, both were diffed against each other on real
    // production data: the stored document date from a full ISO datetime, the
    // document read shape key by key, and the reference lookup that stands
    // between a sale and a duplicate — including the prefix trap and an empty
    // reference. All identical.
    //
    // Nem tudo: um diff campo a campo das dez rotas que o worker realmente
    // chama (08/09/2026) encontrou mais duas a divergir. `related` respondia
    // 400 onde o antigo responde lista vazia — o IX devolve 404 para um
    // documento sem nada emitido contra ele, e o caminho de anulação recusa-se
    // a creditar o que não consiga provar ausente, portanto as anulações teriam
    // parado. E `link` embrulhava o URL em `{url}` onde o worker lê a string
    // nua, o que esvaziava o link de todos os emails ao comerciante. Ambas
    // corrigidas em ix-proxy/ (abeb673) antes do corte.
    //
    // Rollback is this value: "https://ix-proxy.kapta.app" returns to the old
    // one. A MISSING value also means the old one — see src/api/ix/base-url.ts —
    // so removing the line is equally safe. Rolling back needs no code change,
    // but it does need a deploy, because this is a var and not a secret.
    "IX_PROXY_URL": "https://ix.rioko.online",
    "STRIPE_HEAL_ENABLED": "1",
    "STRIPE_HEAL_DAYS": "30",
    "STRIPE_HEAL_USERS": "",
    // Document verification sweep. Enabled 2026-08-15 after a manual run proved
    // the capped concurrency holds: 300 documents read from Zoo de Lagos in 18s
    // with zero unreadable, against a proxy that collapsed at 200 simultaneous.
    "DOC_VERIFY_ENABLED": "1",
    "DOC_VERIFY_DAYS": "3",
    "DOC_VERIFY_LIMIT": "500",
    "DOC_VERIFY_BUDGET_MS": "480000"
  },
  "kv_namespaces": [
    {
      "binding": "INVOICE_KV",
      "id": "396a96276266418ba7fc6ee08a487b6d"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rioko-db",
      "database_id": "4c63109a-c05d-427f-abf2-1cb4a757df88"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SHOPIFY_ORDERS_QUEUE",
        "queue": "shopifyordersqueue"
      },
      {
        "binding": "STRIPE_QUEUE",
        "queue": "stripeeventsqueue"
      }
    ],
    "consumers": [
      {
        "queue": "shopifyordersqueue",
        "max_batch_size": 10,
        "dead_letter_queue": "my-queue-dlq",
        "max_retries": 10
      },
      {
        "queue": "stripeeventsqueue",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "dead_letter_queue": "my-queue-dlq",
        "max_retries": 10
      },
      {
        "queue": "my-queue-dlq",
        "max_batch_size": 5,
        "max_retries": 1
      }
    ]
  },
  "triggers": {
    // */30 * * * * → Lodgify booking poll (no webhook access on user API keys)
    // 0 4 * * *    → self-healing invoice reconciliation sweep (RECON_SWEEP_ENABLED)
    // 0 8 * * *    → daily ops sweep (IX match retry, VIES retry, TTL purge)
    // 0 16 * * 5   → Friday weekly per-merchant "unprocessed invoices" digest
    "crons": ["*/30 * * * *", "0 4 * * *", "0 8 * * *", "0 16 * * 5"]
  },
  "limits": {
    "cpu_ms": 60000
  }
}
